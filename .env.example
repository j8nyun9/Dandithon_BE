PORT=3001
# 로컬 기본값은 127.0.0.1, 외부 호스팅에서는 0.0.0.0
HOST=127.0.0.1
DB_PATH=dandi.sqlite
DANDI_SECRET=replace-with-long-random-secret
AI_MODE=mock

# 승인 완료 건수 목표 (헌혈 제외)
COMMUNITY_GOAL_TARGET=100

# OpenAI AI: 공고 수집·분류와 학생 추천 (AI_MODE=live 필요)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 웹 검색 전용 모델 (도메인 제한 지원 필요)
OPENAI_SEARCH_MODEL=gpt-6-luna
